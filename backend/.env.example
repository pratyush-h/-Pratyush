# MongoDB Atlas or Local MongoDB connection URI (Viewable in MongoDB Compass)
# Atlas format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/student_db?retryWrites=true&w=majority
# Local Compass format: mongodb://localhost:27017/student_db
MONGO_DETAILS=mongodb://localhost:27017/student_db

# JWT Security
SECRET_KEY=supersecretjwtkey_change_this_for_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional - Built-in Multi-Agent Fallback works automatically without keys)
GEMINI_API_KEY=
GROQ_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
